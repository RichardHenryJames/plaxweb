# Where enquiries are delivered.
#
# With no RESEND_API_KEY the contact form still works end to end — the lead is
# written to the server log instead of being emailed. That keeps local dev and
# preview deployments functional without secrets.

# Transactional email (https://resend.com). Optional.
RESEND_API_KEY=
# Verified sender, e.g. "PlaxWeb <hello@plaxlabs.com>"
LEAD_FROM=
# Where enquiries land. Defaults to site.email in lib/site.ts.
LEAD_INBOX=

# Absolute origin used for canonical URLs, Open Graph and the sitemap.
# On Vercel this is inferred; set it when serving from plaxlabs.com.
NEXT_PUBLIC_SITE_ORIGIN=https://plaxlabs.com

# ── Lead storage ────────────────────────────────────────────────────────────
# The SAME Supabase project the Plax news app uses. Copy both values from that
# project so the two apps share one database and one keep-alive.
#
# Apply supabase-schema.sql once before the first enquiry, or inserts fail and
# the lead survives only in the email and the server log.
#
# The service role key bypasses row-level security. It must never be exposed to
# the browser, so it has no NEXT_PUBLIC_ prefix and is only read in lib/supabase.ts.
# SUPABASE_URL is read at runtime, so changing it does not need a rebuild.
# NEXT_PUBLIC_SUPABASE_URL is also accepted, but it is baked in at build time,
# so a deployment made before you set it will not see it until you redeploy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
